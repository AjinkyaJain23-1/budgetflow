# ── Frontend ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend ─────────────────────────────────────────────────────────
# Auth
SECRET_KEY=change-this-in-production-long-random-string
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Database & Cache
DATABASE_URL=postgresql://culturaltune:culturaltune_pass@localhost:5432/culturaltune_db
REDIS_URL=redis://localhost:6379/0

# AWS S3 (for audio storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=culturaltune-ai-audio
# CDN_BASE_URL=https://cdn.culturaltune.ai

# Spotify (for metadata extraction)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# AI Configuration
# Set to 'false' to enable actual AI models (requires GPU)
MOCK_AI=true
MUSICGEN_MODEL=facebook/musicgen-small
WORK_DIR=/tmp/culturaltune/work
